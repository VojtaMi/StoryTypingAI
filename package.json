{
	"name": "story-typing-final",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "concurrently \"npm:dev:api\" \"npm:dev:vite\"",
		"dev:api": "PORT=3001 tsx watch --env-file-if-exists=.env.local src/server/production.ts",
		"dev:vite": "vite",
		"build": "tsc -b && vite build && npm run build:server",
		"build:server": "vite build --config vite.server.config.ts",
		"preview": "vite preview",
		"check": "npm run build && npm run lint",
		"lint": "biome ci .",
		"lint:fix": "biome check --write .",
		"lint:staged": "biome check --staged --no-errors-on-unmatched",
		"prepare": "husky",
		"backfill:opening-audio": "tsx scripts/backfill-opening-audio.ts",
		"audio:variants": "tsx scripts/generate-audio-variants.ts",
		"gemini:images": "tsx --env-file-if-exists=.env.local scripts/compare-gemini-images.ts",
		"gemini:tts": "tsx --env-file-if-exists=.env.local scripts/test-gemini-tts.ts",
		"model:compare": "tsx --env-file-if-exists=.env.local scripts/compare-text-models.ts",
		"test:opening": "tsx scripts/test-opening.ts"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.104.2",
		"openai": "^6.42.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@types/node": "^25.9.3",
		"@types/react": "^19.1.0",
		"@types/react-dom": "^19.1.0",
		"@vitejs/plugin-react": "^6.0.3",
		"concurrently": "^10.0.3",
		"husky": "^9.1.7",
		"tsx": "^4.19.4",
		"typescript": "^5.6.3",
		"vite": "^8.1.0"
	}
}
