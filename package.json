{
	"name": "story-typing-final",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"ai-log:pretty": "tsx scripts/format-ai-call-log.ts pretty",
		"ai-log:summary": "tsx scripts/format-ai-call-log.ts summary",
		"audio:variants": "tsx scripts/generate-audio-variants.ts",
		"backfill:opening-audio": "tsx scripts/backfill-opening-audio.ts",
		"bricks:test": "node --import ./scripts/register-css-loader.mjs --import tsx tests/bricks.test.ts",
		"build": "tsc -b && vite build && npm run build:server",
		"build:server": "vite build --config vite.server.config.ts && node -e \"require('node:fs').copyFileSync('dist-server/production.js','server.mjs')\"",
		"check": "npm run build && npm run lint && npm run bricks:test && npm run lessons:test && npm run reading:test && npm run story-cli:test && npm run model-selection:test && npm run reading:preparation:test && npm run finish-evidence:test && npm run story-recap:test && npm run word-audio:test",
		"dev": "concurrently \"npm:dev:api\" \"npm:dev:vite\"",
		"dev:api": "PORT=3002 tsx watch --env-file-if-exists=.env.local src/server/production.ts",
		"dev:vite": "vite",
		"gemini:images": "tsx --env-file-if-exists=.env.local scripts/compare-gemini-images.ts",
		"gemini:tts": "tsx --env-file-if-exists=.env.local scripts/test-gemini-tts.ts",
		"gemini:tts:compare": "tsx --env-file-if-exists=.env.local scripts/compare-gemini-tts.ts",
		"lesson:generation:append": "node --import ./scripts/register-css-loader.mjs --import tsx scripts/append-authored-lesson.ts",
		"lesson:generation:bricks": "node --import ./scripts/register-css-loader.mjs --import tsx scripts/describe-lesson-bricks.ts",
		"lesson:generation:test": "node --import ./scripts/register-css-loader.mjs --import tsx scripts/test-lesson-generation.ts",
		"lessons:test": "node --import ./scripts/register-css-loader.mjs --import tsx tests/lessons.test.ts",
		"lint": "biome ci .",
		"lint:fix": "biome check --write .",
		"lint:staged": "biome check --staged --no-errors-on-unmatched",
		"model-selection:test": "tsx tests/model-selection.test.ts",
		"prepare": "husky",
		"preview": "vite preview",
		"start": "NODE_ENV=production PORT=8080 node --env-file-if-exists=.env server.mjs",
		"reading:test": "tsx tests/reading-story.test.ts",
		"reading:preparation:test": "node --import ./scripts/register-css-loader.mjs --import tsx tests/reading-preparation.test.ts",
		"finish-evidence:test": "tsx tests/story-finish-evidence.test.ts",
		"story-cli:test": "tsx tests/story-cli.test.ts",
		"story-recap:test": "tsx tests/story-recap.test.ts",
		"story:generate": "tsx --env-file-if-exists=.env.local scripts/generate-reading-story.ts",
		"story:chain": "tsx --env-file-if-exists=.env.local scripts/simulate-reading-story-chain.ts",
		"story:typing-opening": "tsx --env-file-if-exists=.env.local scripts/generate-typing-opening.ts",
		"verify:page": "node scripts/verify-page.mjs",
		"word-audio:test": "tsx tests/word-audio-store.test.ts"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.104.2",
		"openai": "^6.42.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"sharp": "^0.35.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@types/node": "^25.9.3",
		"@types/react": "^19.1.0",
		"@types/react-dom": "^19.1.0",
		"@vitejs/plugin-react": "^6.0.3",
		"concurrently": "^10.0.3",
		"husky": "^9.1.7",
		"playwright": "1.61.1",
		"tsx": "^4.19.4",
		"typescript": "^5.6.3",
		"vite": "^8.1.0"
	}
}
