{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "mcp__playwright__browser_take_screenshot",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/screenshot-to-artifacts.mjs\"",
						"timeout": 10,
						"statusMessage": "Redirecting screenshot into .artifacts/"
					}
				]
			}
		]
	}
}
